{
  "name": "@haneoka/vega-catalog-official",
  "version": "0.1.0",
  "description": "Curated metadata-only official plugin catalog for Vega, Altair and Deneb",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega-marketplace.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega-marketplace/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega-marketplace#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "catalog.json",
    "catalog.sha256",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog:verify": "node scripts/verify-catalog.mjs",
    "catalog:digest": "node scripts/write-catalog-digest.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run catalog:verify",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@haneoka/vega": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/vega": "workspace:*",
    "@haneoka/vega-protocol": "workspace:*",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "vega": {
    "pluginApi": 1,
    "kind": "catalog",
    "capabilities": [],
    "permissions": [],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
